# Public placeholders only (rule R5). Read only by `vite build --mode e2e` (pnpm e2e, ADR 0006).
# The host is never resolved: Playwright answers every request to it (e2e/support/fake-api.ts).
VITE_API_BASE_URL=https://api.e2e.test
VITE_APP_KEY=admin
# Explicitly empty so a developer's .env.local cannot leak in.
VITE_TURNSTILE_SITE_KEY=
